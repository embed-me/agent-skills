{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "small_model": "deepseek/deepseek-v4-flash",
  "default_agent": "orchestrator",
  "subagent_depth": 1,
  "instructions": [
    "docs/definition-of-done.md",
    "skills/using-agent-skills/SKILL.md"
  ],
  "formatter": true,
  "lsp": true,
  "autoupdate": true,
  "share": "manual",
  "compaction": {
    "auto": true,
    "prune": true,
    "reserved": 16000
  },
  "watcher": {
    "ignore": [
      "**/.git/**",
      "**/build/**",
      "**/.venv/**",
      "**/__pycache__/**"
    ]
  },
  "permission": {
    "*": "allow",
    "edit": "allow",
    "webfetch": "allow",
    "external_directory": "ask",
    "bash": {
      "*": "allow",
      "rm *": "ask",
      "rmdir *": "ask",
      "git push *": "ask",
      "sudo *": "ask"
    }
  }
}
